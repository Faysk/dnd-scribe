{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/central-local",
      "destination": "/central-local/index.html"
    },
    {
      "source": "/edit",
      "destination": "/central-local/index.html"
    },
    {
      "source": "/edit/",
      "destination": "/central-local/index.html"
    },
    {
      "source": "/edit/:path*",
      "destination": "/central-local/:path*"
    },
    {
      "source": "/api/roll20-bridge/config",
      "destination": "/api/roll20-bridge?roll20BridgeConfig=1"
    },
    {
      "source": "/api/lore/dandelion",
      "destination": "/api/lore-dandelion"
    },
    {
      "source": "/api/lore/asset",
      "destination": "/api/lore-asset"
    },
    {
      "source": "/api/roll20/bridge/config",
      "destination": "/api/roll20-bridge?roll20BridgeConfig=1"
    },
    {
      "source": "/api/jobs/retry",
      "destination": "/api/job-retry"
    },
    {
      "source": "/api/jobs/control",
      "destination": "/api/job-control"
    },
    {
      "source": "/api/jobs/pipeline-continue",
      "destination": "/api/pipeline-continue"
    },
    {
      "source": "/api/jobs/run-cloud-plan-chunks",
      "destination": "/api/run-cloud-plan-chunks"
    },
    {
      "source": "/api/discord/interactions",
      "destination": "/api/ai-cost?discordInteractions=1"
    },
    {
      "source": "/api/pipeline-recover",
      "destination": "/api/ai-cost?pipelineRecover=1"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/linked-role",
      "destination": "/linked-role.html"
    }
  ],
  "headers": [
    {
      "source": "/central-local",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/central-local/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/central-local/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/edit",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/edit/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/edit/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "lore-runtime/**"
    }
  },
  "crons": [
    {
      "path": "/api/pipeline-supervisor",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/discord-catch-up",
      "schedule": "45 4 * * *"
    }
  ]
}
