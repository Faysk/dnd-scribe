{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/central-local",
      "destination": "/edit/",
      "permanent": false
    },
    {
      "source": "/central-local/",
      "destination": "/edit/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "https://dnd-scribe-web-next.vercel.app/"
    },
    {
      "source": "/sessoes",
      "destination": "https://dnd-scribe-web-next.vercel.app/sessoes"
    },
    {
      "source": "/sessoes/:path*",
      "destination": "https://dnd-scribe-web-next.vercel.app/sessoes/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://dnd-scribe-web-next.vercel.app/_next/:path*"
    },
    {
      "source": "/login",
      "destination": "https://dnd-scribe-web-next.vercel.app/login"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://dnd-scribe-web-next.vercel.app/auth/:path*"
    },
    {
      "source": "/api/web/:path*",
      "destination": "https://dnd-scribe-web-next.vercel.app/api/web/:path*"
    },
    {
      "source": "/api/library/:path*",
      "destination": "https://dnd-scribe-web-next.vercel.app/api/library/:path*"
    },
    {
      "source": "/design-system",
      "destination": "https://dnd-scribe-web-next.vercel.app/design-system"
    },
    {
      "source": "/api/v1/health",
      "destination": "/api/summary-api-v1?summaryApiRoute=health"
    },
    {
      "source": "/api/v1/summaries",
      "destination": "/api/summary-api-v1?summaryApiRoute=summaries"
    },
    {
      "source": "/api/v1/summaries/:id",
      "destination": "/api/summary-api-v1?summaryApiRoute=detail&summaryId=:id"
    },
    {
      "source": "/api/integrations/api-keys",
      "destination": "/api/integration-api-keys"
    },
    {
      "source": "/api/integrations/api-keys/revoke",
      "destination": "/api/integration-api-key-revoke"
    },
    {
      "source": "/api/integrations/api-keys/rotate",
      "destination": "/api/integration-api-key-rotate"
    },
    {
      "source": "/central-local",
      "destination": "/central-local/index.html"
    },
    {
      "source": "/edit",
      "destination": "/central-local/index.html"
    },
    {
      "source": "/edit/",
      "destination": "/central-local/index.html"
    },
    {
      "source": "/edit/:path*",
      "destination": "/central-local/:path*"
    },
    {
      "source": "/api/companion-release",
      "destination": "/api/ai-cost?companionRelease=1"
    },
    {
      "source": "/api/roll20-bridge/config",
      "destination": "/api/roll20-bridge?roll20BridgeConfig=1"
    },
    {
      "source": "/api/lore/dandelion",
      "destination": "/api/lore-dandelion"
    },
    {
      "source": "/api/lore/asset",
      "destination": "/api/lore-asset"
    },
    {
      "source": "/api/roll20/bridge/config",
      "destination": "/api/roll20-bridge?roll20BridgeConfig=1"
    },
    {
      "source": "/api/jobs/retry",
      "destination": "/api/job-retry"
    },
    {
      "source": "/api/jobs/control",
      "destination": "/api/job-control"
    },
    {
      "source": "/api/jobs/pipeline-continue",
      "destination": "/api/pipeline-continue"
    },
    {
      "source": "/api/jobs/run-cloud-plan-chunks",
      "destination": "/api/run-cloud-plan-chunks"
    },
    {
      "source": "/api/discord/interactions",
      "destination": "/api/ai-cost?discordInteractions=1"
    },
    {
      "source": "/api/pipeline-recover",
      "destination": "/api/ai-cost?pipelineRecover=1"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/linked-role",
      "destination": "/linked-role.html"
    },
    {
      "source": "/docs/api",
      "destination": "/api-docs.html"
    },
    {
      "source": "/docs/api/",
      "destination": "/api-docs.html"
    },
    {
      "source": "/docs/api/openapi.yaml",
      "destination": "/openapi-summary-v1.yaml"
    }
  ],
  "headers": [
    {
      "source": "/central-local",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/central-local/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/central-local/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/edit",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/edit/",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    },
    {
      "source": "/edit/:path*",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "local-network=(self), loopback-network=(self)"
        }
      ]
    }
  ],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "lore-runtime/**"
    }
  },
  "crons": [
    {
      "path": "/api/pipeline-supervisor",
      "schedule": "15 4 * * *"
    },
    {
      "path": "/api/cron/discord-catch-up",
      "schedule": "45 4 * * *"
    }
  ]
}
