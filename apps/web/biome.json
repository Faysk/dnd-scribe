{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"includes": [
			"**",
			"!!.next",
			"!!node_modules",
			"!!test-results",
			"!!playwright-report",
			"!next-env.d.ts"
		]
	},
	"formatter": { "enabled": false },
	"assist": { "enabled": false },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"css": { "parser": { "tailwindDirectives": true } }
}
