# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Stable technical origin of the legacy project used only by the Next server/BFF
# and by the cutover fallback rewrites. It MUST NOT point to dnd.faysk.dev,
# otherwise the public-domain cutover could create a self-loop.
# Verified on 2026-09-04: this project-level Vercel domain serves the current legacy API.
DND_LEGACY_ORIGIN="https://dnd-scribe-amber.vercel.app"

# Optional explicit origin used by the canOpenEdit bridge.
# When omitted, the app falls back to DND_LEGACY_ORIGIN.
DND_LEGACY_EDIT_ORIGIN="https://dnd-scribe-amber.vercel.app"
